# Server-only settings for compose.prod.yaml. No image API keys are used.
PYTORCH_CUDA_IMAGE=pytorch/pytorch:2.14.1-cuda12.6-cudnn9-runtime
FRONTEND_BIND_IP=0.0.0.0
FRONTEND_PORT=8080

STATION_ID=qma-kiosk-server
ADMIN_API_KEY=
LOCAL_IMAGE_WIDTH=1024
LOCAL_IMAGE_HEIGHT=576
LOCAL_IMAGE_GUIDANCE=6.0
MAX_PENDING_JOBS=4
MIN_FREE_DISK_MB=2048
BACKEND_STOP_GRACE_PERIOD=20m
ALLOW_FREE_TEXT=false
LOCAL_IMAGE_ENGINE=flux3
LOCAL_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
LOCAL_IMAGE_STEPS=16
GENERATION_TIMEOUT_SECONDS=900
MAX_GENERATION_ATTEMPTS=2
MODEL_CACHE_DIR=./models/flux3-hub

# Distilled FLUX keeps 16 steps; alternate resolutions are opt-in.
INFERENCE_PROFILE=balanced
VISUAL_VALIDATION_THRESHOLD=85
# JSON argv for a local vision evaluator; [] means visual validation is unavailable.
VISUAL_EVALUATOR_COMMAND=[]
# Optional operator-curated manifest; reference paths are relative to this file.
REFERENCE_MANIFEST=
# -1 disables approximate duplicate rejection; exact hashes remain enabled.
PERCEPTUAL_DUPLICATE_DISTANCE=-1
