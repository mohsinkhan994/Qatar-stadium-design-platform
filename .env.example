# mock is a labelled schematic for development, NOT an AI/offline acceptance demo.
GENERATION_PROVIDER=mock
DATA_DIR=./data
STATION_ID=macbook-demo
# Archive search/export are disabled until this is set. Use a long random value.
ADMIN_API_KEY=
# Optional bearer token for visitor endpoints; required before network deployment.
KIOSK_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set only the provider you plan to use. Keys stay on the backend.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=2K

# Free local generation. Native Mac runs on MPS; compose.dev.yaml runs on CPU.
LOCAL_IMAGE_MODEL_CACHE=./models/flux3-hub
LOCAL_IMAGE_WIDTH=1024
LOCAL_IMAGE_HEIGHT=576
LOCAL_IMAGE_GUIDANCE=6.0

MAX_PENDING_JOBS=8
MIN_FREE_DISK_MB=512
# A repeated decoded image can trigger one extra, billable generation.
# Off until museum-approved English/Arabic free-text moderation is integrated.
# Surprise me works without free text.
ALLOW_FREE_TEXT=false

# Docker Compose only: host port and time allowed for graceful shutdown.
BACKEND_PORT=8001
FRONTEND_PORT=3000
BACKEND_STOP_GRACE_PERIOD=7m

# Plain docker compose commands use the Mac development stack.
COMPOSE_FILE=compose.dev.yaml
DOCKER_LOCAL_IMAGE_WIDTH=768
DOCKER_LOCAL_IMAGE_HEIGHT=512
DEV_GENERATION_TIMEOUT_SECONDS=1800
LOCAL_BACKEND_STOP_GRACE_PERIOD=35m
LOCAL_IMAGE_ENGINE=flux3
LOCAL_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
LOCAL_IMAGE_STEPS=16
GENERATION_TIMEOUT_SECONDS=900
MAX_GENERATION_ATTEMPTS=1
LOCAL_IMAGE_DEVICE=mps
DOCKER_LOCAL_IMAGE_STEPS=16
